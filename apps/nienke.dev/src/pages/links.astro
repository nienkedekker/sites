---
import PageLayout from "../layouts/PageLayout.astro";
import ArrowUpRight from "phosphor-astro/ArrowUpRight.astro";
import { links, linksIntro } from "../data/links";

const hostname = (href: string) => new URL(href).hostname.replace(/^www\./, "");
---

<PageLayout title="Links" intro={linksIntro} markdown="/links.md">
  <ul
    class="grid grid-cols-1 overflow-hidden border border-rule sm:grid-cols-2 lg:grid-cols-3"
  >
    {
      links.map(({ name, href }, i) => (
        <li
          data-reveal
          style={`--delay: ${(i % 3) * 50}ms`}
          class="-mr-px -mb-px border-r border-b border-rule"
        >
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex h-full items-center justify-between gap-4 bg-panel px-5 py-5 transition-colors hover:bg-panel-2"
          >
            <span class="min-w-0">
              <span class="block font-medium [overflow-wrap:anywhere]">
                {name}
              </span>
              <span class="mt-1 block truncate font-mono text-xs text-ink-faint">
                {hostname(href)}
              </span>
            </span>
            <ArrowUpRight class="size-4 shrink-0 text-ink-faint transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-ink" />
          </a>
        </li>
      ))
    }
  </ul>
</PageLayout>
