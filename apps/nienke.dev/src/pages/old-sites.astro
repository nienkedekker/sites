---
import { formatDate } from "@nienke/ui/format";
import ArrowUpRight from "phosphor-astro/ArrowUpRight.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { oldSites, oldSitesIntro } from "../data/old-sites";

const snapshotDate = (date: string) =>
  formatDate(new Date(date), {
    year: "numeric",
    month: "short",
    ...(date.length > 7 && { day: "numeric" }),
  });
---

<PageLayout title="Old sites" intro={oldSitesIntro} markdown="/old-sites.md">
  <div class="space-y-24 sm:space-y-32">
    {
      oldSites.map(({ domain, years, about, snapshots }) => (
        <section class="grid grid-cols-1 gap-10 border-t border-rule pt-10 lg:grid-cols-12 lg:gap-16">
          <header data-reveal class="lg:col-span-4">
            <div class="lg:sticky lg:top-24">
              <p class="font-mono text-xs text-ink-faint">{years}</p>
              <h2 class="display mt-3 text-[2rem] text-ink [overflow-wrap:anywhere] sm:text-[2.5rem]">
                {domain}
              </h2>
              <p class="mt-5 max-w-md leading-[1.6] text-ink-soft">{about}</p>
            </div>
          </header>

          <ol class="border-l border-rule lg:col-span-8">
            {snapshots.map(
              ({ date, title, archive, note, quote, source, image }) => (
                <li data-reveal class="relative pb-14 pl-6 last:pb-0 sm:pl-10">
                  <span
                    aria-hidden="true"
                    class="absolute top-1.5 -left-[5px] size-[9px] border border-rule bg-paper"
                  />
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                    <time datetime={date} class="tag">
                      {snapshotDate(date)}
                    </time>
                    <a
                      href={archive}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group flex items-center gap-1 font-mono text-xs text-ink-faint transition-colors hover:text-ink"
                    >
                      Wayback Machine
                      <ArrowUpRight class="size-3 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
                    </a>
                  </div>

                  <h3 class="display mt-4 text-[1.75rem] text-ink [overflow-wrap:anywhere] sm:text-[2.125rem]">
                    {title}
                  </h3>

                  {image && (
                    <figure class="mt-6 w-fit max-w-full">
                      <a
                        href={image.src}
                        target="_blank"
                        class="block max-h-[36rem] overflow-y-auto border border-rule shadow-[6px_6px_0_var(--rule)]"
                      >
                        <img
                          src={image.src}
                          alt={image.alt}
                          width={image.width}
                          height={image.height}
                          loading="lazy"
                          decoding="async"
                          class="block h-auto max-w-full"
                        />
                      </a>
                      {image.caption && (
                        <figcaption class="mt-4 max-w-xl font-mono text-xs leading-[1.6] text-ink-faint">
                          {image.caption}
                        </figcaption>
                      )}
                    </figure>
                  )}

                  {note && (
                    <p class="mt-5 max-w-xl leading-[1.6] text-ink-soft">
                      {note}
                    </p>
                  )}

                  {quote && (
                    <blockquote class="mt-5 max-w-xl border-l-2 border-line-strong pl-4 font-mono text-[0.8125rem] leading-[1.65] text-ink">
                      {quote}
                    </blockquote>
                  )}

                  {source && (
                    <figure class="mt-5 max-w-xl">
                      <figcaption class="font-mono text-xs leading-[1.6] text-ink-faint">
                        {source.label}
                      </figcaption>
                      <pre
                        class="mt-3 overflow-x-auto border border-rule p-4 font-mono text-[0.75rem] leading-[1.65] text-ink-soft"
                        set:text={source.code}
                      />
                    </figure>
                  )}
                </li>
              )
            )}
          </ol>
        </section>
      ))
    }
  </div>
</PageLayout>
