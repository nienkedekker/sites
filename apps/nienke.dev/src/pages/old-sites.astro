---
import { formatDate } from "@nienke/ui/format";
import { Code } from "astro:components";
import ArchiveFooter from "../components/archive-footer.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { oldSiteId, oldSites, oldSitesIntro } from "../data/old-sites";
import { snippetTheme } from "../lib/snippet-theme";

const snapshotId = (domain: string, date: string) =>
  `${oldSiteId(domain)}-${date}`;

const snapshotDate = (date: string) =>
  formatDate(new Date(date), {
    year: "numeric",
    month: "short",
    ...(date.length > 7 && { day: "numeric" }),
  });
---

<PageLayout
  title="Old sites"
  intro={oldSitesIntro}
  markdown="/old-sites.md"
  parent={{ href: "/archive", label: "Archive" }}
>
  <div class="space-y-24 sm:space-y-32">
    {
      oldSites.map(({ domain, years, about, snapshots }) => (
        <section
          id={oldSiteId(domain)}
          class="grid scroll-mt-20 grid-cols-1 gap-10 border-t border-rule pt-10 lg:grid-cols-12 lg:gap-16"
        >
          <header data-reveal class="lg:col-span-5">
            <div class="lg:sticky lg:top-24">
              <a
                href={`#${oldSiteId(domain)}`}
                class="font-mono text-xs text-movies-text underline-offset-4 hover:underline"
              >
                {years}
              </a>
              <h2 class="display mt-3 text-[2rem] text-ink [overflow-wrap:anywhere] sm:text-[2.5rem]">
                {domain.split(/(?<=[./])/).map((part, i) => (
                  <>
                    {i > 0 && <wbr />}
                    {part}
                  </>
                ))}
              </h2>
              <p class="mt-5 max-w-md leading-[1.6] text-ink-soft">{about}</p>
            </div>
          </header>

          <ol class="border-l border-rule lg:col-span-7">
            {snapshots.map(({ date, title, note, quote, source, image }) => (
              <li
                id={snapshotId(domain, date)}
                data-reveal
                class="relative scroll-mt-20 pb-14 pl-6 last:pb-0 sm:pl-10"
              >
                <span
                  aria-hidden="true"
                  class="absolute top-1.5 -left-[5px] size-[9px] border border-rule bg-paper"
                />
                <a
                  href={`#${snapshotId(domain, date)}`}
                  class="tag border-movies-text text-movies-text hover:bg-movies-text hover:text-paper"
                >
                  <time datetime={date}>{snapshotDate(date)}</time>
                </a>

                <h3 class="display mt-4 text-[1.75rem] text-ink [overflow-wrap:anywhere] sm:text-[2.125rem]">
                  {title}
                </h3>

                {image && (
                  <figure class="mt-6 w-fit max-w-full">
                    <a
                      href={image.src}
                      target="_blank"
                      class="scrollbar-visible block max-h-[36rem] overflow-y-auto framed"
                    >
                      <img
                        src={image.src}
                        alt={image.alt}
                        width={image.width}
                        height={image.height}
                        loading="lazy"
                        decoding="async"
                        class="block h-auto max-w-full"
                      />
                    </a>
                    {image.caption && (
                      <figcaption class="mt-4 max-w-xl font-mono text-xs leading-[1.6] text-ink-faint">
                        {image.caption}
                      </figcaption>
                    )}
                  </figure>
                )}

                {note && (
                  <p class="mt-5 max-w-xl leading-[1.6] text-ink-soft">
                    {note}
                  </p>
                )}

                {quote && (
                  <blockquote class="mt-5 max-w-xl border-l-2 border-line-strong pl-4 font-mono text-[0.8125rem] leading-[1.65] text-ink">
                    {quote}
                  </blockquote>
                )}

                {source && (
                  <figure class="mt-5 max-w-xl">
                    <Code
                      code={source.code}
                      lang={source.lang ?? "html"}
                      theme={snippetTheme}
                      class="border border-rule p-4 font-mono text-[0.75rem] leading-[1.65]"
                    />
                    <figcaption class="mt-4 font-mono text-xs leading-[1.6] text-ink-faint">
                      {source.label}
                    </figcaption>
                  </figure>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>

  <ArchiveFooter />
</PageLayout>

<script>
  // The browser's own jump measures the target mid-reveal, while it's still
  // shifted down, so it lands short. offsetTop ignores those transforms.
  const layoutTop = (element: HTMLElement) => {
    let top = 0;
    for (
      let e: Element | null = element;
      e instanceof HTMLElement;
      e = e.offsetParent
    ) {
      top += e.offsetTop;
    }
    return top;
  };

  // Same for links on the page: show the target before the browser measures it.
  document.addEventListener("click", (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>(
      'main a[href^="#"]'
    );
    const target = link && document.getElementById(link.hash.slice(1));
    if (!target?.matches("[data-reveal]")) return;
    target.style.transition = "none";
    target.classList.add("is-visible");
    target.getBoundingClientRect();
    requestAnimationFrame(() => (target.style.transition = ""));
  });

  document.addEventListener("astro:page-load", () => {
    const target = document.getElementById(
      decodeURIComponent(location.hash.slice(1))
    );
    if (!target) return;
    const jump = () =>
      scrollTo({
        top:
          layoutTop(target) -
          parseFloat(getComputedStyle(target).scrollMarginTop),
        behavior: "instant",
      });
    jump();

    // The browser can still be smooth-scrolling to the anchor itself, so
    // correct it whenever a scroll ends, until the reader takes over.
    const settled = new AbortController();
    const { signal } = settled;
    addEventListener("scrollend", jump, { signal });
    for (const type of ["wheel", "touchstart", "pointerdown", "keydown"]) {
      addEventListener(type, () => settled.abort(), { signal });
    }
    setTimeout(() => settled.abort(), 2000);
  });
</script>
