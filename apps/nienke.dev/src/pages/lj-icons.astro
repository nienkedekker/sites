---
import ArchiveFooter from "../components/archive-footer.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { ljIcons, ljIconsIntro } from "../data/lj-icons";
---

<PageLayout
  title="LiveJournal icons"
  intro={ljIconsIntro}
  markdown="/lj-icons.md"
  parent={{ href: "/archive", label: "Archive" }}
>
  <ul aria-label={`${ljIcons.length} icons`} class="flex flex-wrap gap-3">
    {
      ljIcons.map((src) => (
        <li>
          <img
            src={src}
            alt=""
            width="100"
            height="100"
            loading="lazy"
            decoding="async"
            class="block"
          />
        </li>
      ))
    }
  </ul>

  <ArchiveFooter />
</PageLayout>
