---
import ArrowUpRight from "phosphor-astro/ArrowUpRight.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { ljIcons, ljIconsArchive, ljIconsIntro } from "../data/lj-icons";
---

<PageLayout
  title="LiveJournal icons"
  intro={ljIconsIntro}
  markdown="/lj-icons.md"
>
  <ul aria-label={`${ljIcons.length} icons`} class="flex flex-wrap gap-3">
    {
      ljIcons.map((src) => (
        <li>
          <img
            src={src}
            alt=""
            width="100"
            height="100"
            loading="lazy"
            decoding="async"
            class="block"
          />
        </li>
      ))
    }
  </ul>

  <a
    href={ljIconsArchive}
    target="_blank"
    rel="noopener noreferrer"
    class="group mt-10 inline-flex items-center gap-1 font-mono text-xs text-ink-faint transition-colors hover:text-ink"
  >
    airings.livejournal.com on the Wayback Machine
    <ArrowUpRight
      class="size-3 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
    />
  </a>
</PageLayout>
