---
import { getCollection, render } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import LiveNumbers from "../components/live-numbers.astro";
import { getLiveNumbers } from "../lib/home-snapshot";
import { hasLiveNumbers } from "../lib/live-numbers";

export async function getStaticPaths() {
  const pages = await getCollection("pages", ({ id }) => id !== "home");
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const numbers = hasLiveNumbers(page.body ?? "") ? await getLiveNumbers() : null;
---

<PageLayout
  title={page.data.title}
  intro={page.data.description}
  lastUpdated={page.data.lastUpdated}
  markdown={`/${page.id}.md`}
  headerClass="mb-10"
>
  <article class="prose max-w-2xl border-t border-line-strong pt-10">
    {
      numbers ? (
        <LiveNumbers numbers={numbers}>
          <Content />
        </LiveNumbers>
      ) : (
        <Content />
      )
    }
  </article>
</PageLayout>
