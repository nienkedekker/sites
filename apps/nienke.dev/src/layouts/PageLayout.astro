---
import { formatDate } from "@nienke/ui/format";
import PageHeader from "@nienke/ui/page-header";
import ArrowLeft from "phosphor-astro/ArrowLeft.astro";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  intro?: string;
  lastUpdated?: Date;
  markdown?: string;
  parent?: { href: string; label: string };
  headerClass?: string;
}

const {
  title,
  intro,
  lastUpdated,
  markdown,
  parent,
  headerClass = "mb-14 sm:mb-16",
} = Astro.props;

const formattedDate = lastUpdated
  ? formatDate(lastUpdated, { year: "numeric", month: "long", day: "numeric" })
  : null;
---

<BaseLayout title={title} description={intro} markdown={markdown}>
  <div class="mx-auto max-w-6xl px-4 pt-20 sm:pt-28">
    {
      parent && (
        <a
          href={parent.href}
          class="rise group mb-8 flex w-fit items-center gap-1 font-mono text-xs text-ink-faint transition-colors hover:text-ink"
        >
          <ArrowLeft class="size-3 transition-transform group-hover:-translate-x-0.5" />
          {parent.label}
        </a>
      )
    }
    <PageHeader
      eyebrow={formattedDate && `Updated ${formattedDate}`}
      intro={intro}
      className={headerClass}
    >
      {title}
    </PageHeader>

    <div class="rise" style="--delay: 240ms">
      <slot />
    </div>
  </div>
</BaseLayout>
