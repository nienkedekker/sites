---
import { formatDate } from "@nienke/ui/format";
import PageHeader from "@nienke/ui/page-header";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  intro?: string;
  lastUpdated?: Date;
  markdown?: string;
}

const { title, intro, lastUpdated, markdown } = Astro.props;

const formattedDate = lastUpdated
  ? formatDate(lastUpdated, { year: "numeric", month: "long", day: "numeric" })
  : null;
---

<BaseLayout title={title} description={intro} markdown={markdown}>
  <div class="mx-auto max-w-6xl px-4 pt-20 sm:pt-28">
    <PageHeader
      eyebrow={formattedDate && `Updated ${formattedDate}`}
      intro={intro}
      className="mb-14 sm:mb-16"
    >
      {title}
    </PageHeader>

    <div class="rise" style="--delay: 240ms">
      <slot />
    </div>
  </div>
</BaseLayout>
