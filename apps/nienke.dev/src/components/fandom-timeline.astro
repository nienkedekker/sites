---
import { formatPlural } from "@nienke/ui/format";
import { HeatCell, HeatLegend } from "@nienke/ui/heatmap";
import { barCentre } from "@nienke/ui/tooltip";
import { fandoms, tumblrFirstYear } from "../data/tumblr-posts";

const QUARTERS = [
  "January–March",
  "April–June",
  "July–September",
  "October–December",
];

const quarters = fandoms[0].counts.length;
const years = Array.from(
  { length: quarters / 4 },
  (_, i) => tumblrFirstYear + i
);
const max = Math.max(...fandoms.flatMap(({ counts }) => counts));
// Lost dwarfs everything else, so the shades follow a log scale.
const scale = "log";
---

<section aria-labelledby="fandoms-heading">
  <h2
    id="fandoms-heading"
    class="display text-[2rem] text-ink sm:text-[2.5rem]"
  >
    Interests
  </h2>
  <p class="mt-4 max-w-xl leading-[1.6] text-ink-soft">
    What I posted about based on surviving tags.
  </p>

  <table
    class="mt-8 w-full table-fixed border-separate border-spacing-[3px] text-[0.7rem]"
  >
    <caption class="sr-only">Tumblr posts per fandom, per quarter</caption>
    <thead>
      <tr>
        <th scope="col" class="w-24 sm:w-44">
          <span class="sr-only">Fandom</span>
        </th>
        {
          years.map((year) => (
            <th
              scope="colgroup"
              colspan="4"
              class="text-left font-mono font-normal text-ink-faint"
            >
              {year}
            </th>
          ))
        }
        <th scope="col" class="hidden w-10 sm:table-cell">
          <span class="sr-only">Total</span>
        </th>
      </tr>
    </thead>
    <tbody>
      {
        fandoms.map(({ name, counts }) => (
          <tr>
            <th
              scope="row"
              class="truncate pr-2 text-left text-xs font-normal text-ink-soft"
            >
              {name}
            </th>
            {counts.map((count, i) => {
              const period = `${QUARTERS[i % 4]} ${years[Math.floor(i / 4)]}`;
              return (
                <td class="h-5 p-0">
                  <HeatCell
                    count={count}
                    max={max}
                    scale={scale}
                    position={barCentre(i, quarters)}
                    label={`${name}, ${period}: ${formatPlural(count, "post")}`}
                    title={name}
                  >
                    <p class="mt-1 text-ink-soft">{period}</p>
                  </HeatCell>
                </td>
              );
            })}
            <td class="hidden text-right font-mono text-ink-faint tabular-nums sm:table-cell">
              {counts.reduce((a, b) => a + b, 0)}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <HeatLegend />
</section>
