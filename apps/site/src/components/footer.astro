---
import VisitorCount from "./visitor-count";
import { profile } from "../data/profile";

const siteLinks = [
  { href: "/now", label: "Now" },
  { href: "/uses", label: "Uses" },
  { href: "/links", label: "Links" },
  { href: "/colophon", label: "Colophon" },
];

const elsewhere = [
  ...profile.profiles,
  { href: `mailto:${profile.email}`, label: "Email" },
];

const navs = [
  { label: "Site", links: siteLinks },
  { label: "Elsewhere", links: elsewhere },
];

const isWeb = (href: string) => /^https?:/.test(href);
---

<footer class="mt-40 border-t border-rule font-mono text-xs text-ink-soft">
  <div class="mx-auto max-w-6xl space-y-3 px-4 py-6">
    <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-2">
      <p>© {new Date().getFullYear()} {profile.name}</p>
      <VisitorCount client:load />
    </div>
    <div class="flex flex-wrap justify-between gap-x-8 gap-y-2">
      {
        navs.map(({ label, links }) => (
          <nav aria-label={label}>
            <ul class="flex flex-wrap gap-x-4 gap-y-1">
              {links.map(({ href, label }) => (
                <li>
                  <a
                    href={href}
                    class="underline decoration-line-strong underline-offset-4 transition-colors hover:text-ink hover:decoration-ink"
                    {...(isWeb(href)
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <div class="border-t border-rule">
    <div
      class="relative z-[101] mx-auto flex max-w-6xl flex-wrap items-center gap-2 px-4 py-5 [image-rendering:pixelated]"
    >
      <img
        src="/buttons/poweredbymac.gif"
        alt="Powered by Mac"
        width="88"
        height="31"
      />
      <img
        src="/buttons/cookiefree.gif"
        alt="Cookie free"
        width="88"
        height="31"
      />
      <button
        id="bookmark-btn"
        class="cursor-pointer"
        title="Bookmark this page"
      >
        <img
          src="/buttons/bookmark.gif"
          alt="Bookmark this page"
          width="88"
          height="31"
        />
      </button>
      <img src="/buttons/3computer.jpg" alt="Computer" width="88" height="31" />
    </div>
  </div>
</footer>

<script>
  function setupBookmarkButton() {
    document.getElementById("bookmark-btn")?.addEventListener("click", () => {
      const isMac = navigator.platform.toUpperCase().indexOf("MAC") >= 0;
      const shortcut = isMac ? "⌘+D" : "Ctrl+D";
      alert(
        `RIP window.external.AddFavorite :( Press ${shortcut} to bookmark this page!`
      );
    });
  }

  document.addEventListener("astro:page-load", setupBookmarkButton);
</script>
