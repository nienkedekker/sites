---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  intro?: string;
  lastUpdated?: Date;
  markdown?: string;
}

const { title, intro, lastUpdated, markdown } = Astro.props;

const formattedDate = lastUpdated
  ? lastUpdated.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
      timeZone: "UTC",
    })
  : null;
---

<BaseLayout title={title} description={intro} markdown={markdown}>
  <div class="mx-auto max-w-6xl px-4 pt-20 sm:pt-28">
    <header class="max-w-2xl">
      {formattedDate && <p class="rise tag mb-6">Updated {formattedDate}</p>}
      <h1
        class="rise display text-ink text-[clamp(2.75rem,7vw,4.5rem)]"
        style="--delay: 80ms"
      >
        {title}
      </h1>
      {
        intro && (
          <p
            class="rise mt-5 text-lg text-ink-soft sm:text-xl"
            style="--delay: 160ms"
          >
            {intro}
          </p>
        )
      }
    </header>

    <div class="rise mt-14 sm:mt-16" style="--delay: 240ms">
      <slot />
    </div>
  </div>
</BaseLayout>
