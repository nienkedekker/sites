---
import BaseLayout from "../layouts/BaseLayout.astro";
import NowPlaying from "../components/now-playing";
import ScrobblesCard from "../components/scrobbles-card";
import ReadingCard from "../components/reading-card";
import KanjiCard from "../components/kanji-card";
import MediaChart from "../components/media-chart";
import { getEntry, render } from "astro:content";
import ArrowRight from "phosphor-astro/ArrowRight.astro";
import MapPin from "phosphor-astro/MapPin.astro";
import { profile, site } from "../data/profile";
import { getHomeSnapshot } from "../lib/home-snapshot";

const home = await getEntry("pages", "home");
const now = await getEntry("pages", "now");
const { Content: HomeIntro } = await render(home!);
// The cards' live data as of this build, so the page has real content
// without JavaScript. The cards refresh it in the browser.
const { summary, progress, track, stats } = await getHomeSnapshot();

const nowUpdated = now?.data.lastUpdated?.toLocaleDateString("en-US", {
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

// Who this site is about, for search engines and agents (schema.org Person)
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${site}/#person`,
  name: profile.name,
  url: `${site}/`,
  description: profile.description,
  image: profile.image,
  jobTitle: profile.jobTitle,
  email: `mailto:${profile.email}`,
  worksFor: { "@type": "Organization", ...profile.employer },
  address: {
    "@type": "PostalAddress",
    addressLocality: profile.locality,
    addressCountry: profile.country,
  },
  knowsAbout: profile.skills,
  sameAs: profile.profiles.map(({ href }) => href),
};

const sectionHeading = "display text-ink text-[1.875rem] sm:text-[3rem]";
---

<BaseLayout markdown="/index.md">
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(personSchema).replace(/</g, "\\u003c")}
  />

  <!-- ─────────────── Hero ─────────────── -->
  <section
    class="mx-auto grid max-w-6xl items-center gap-y-16 px-4 pt-16 sm:pt-28 lg:grid-cols-12 lg:gap-x-16"
  >
    <div class="lg:col-span-7">
      <h1
        class="rise display text-ink text-[clamp(3rem,7.5vw,5.5rem)]"
        style="--delay: 100ms"
      >
        Hoi, I'm Nienke.
      </h1>

      <!-- The first paragraph is a larger, darker lede; the rest stays smaller -->
      <div
        class="rise mt-6 max-w-lg text-base leading-[1.55] text-ink-soft [&_a]:text-ink [&_a]:underline [&_a]:decoration-line-strong [&_a]:underline-offset-4 [&_a:hover]:decoration-ink [&_p:first-child]:text-[1.5rem] [&_p:first-child]:leading-[1.3] [&_p:first-child]:tracking-[-0.01em] [&_p:first-child]:text-ink [&_p+p]:mt-5"
        style="--delay: 200ms"
      >
        <HomeIntro />
      </div>
    </div>

    <figure
      class="group rise relative w-full max-w-sm border border-rule shadow-[6px_6px_0_var(--rule)] sm:max-w-md lg:col-span-5 lg:max-w-none"
      style="--delay: 200ms"
    >
      <!-- Dithered by scripts/dither-photo.mjs: blue dots on transparent,
           over a fixed light background so it looks the same in both themes -->
      <img
        src="/nienke-dither.png"
        alt="Nienke gazing out over the port of Hydra"
        class="aspect-[4/5] w-full bg-[#fcfcfd] object-cover [image-rendering:pixelated]"
        width="320"
        height="548"
      />
      <!-- The original photo shows through on hover -->
      <img
        src="/nienke.jpg"
        alt=""
        class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100"
        width="934"
        height="1600"
        loading="lazy"
        decoding="async"
      />
      <figcaption class="tag absolute bottom-4 left-4 bg-paper">
        <MapPin class="size-3.5" /> Hydra, Greece
      </figcaption>
    </figure>
  </section>

  <!-- ─────────────── Right now ─────────────── -->
  <section
    class="mx-auto mt-32 max-w-6xl px-4 sm:mt-44"
    aria-labelledby="now-heading"
  >
    <div
      data-reveal
      class="mb-10 flex flex-wrap items-end justify-between gap-6"
    >
      <h2 id="now-heading" class={sectionHeading}>Right now</h2>
      <a
        href="/now"
        class="group flex items-center gap-1.5 text-sm text-ink-soft transition-colors hover:text-ink"
      >
        Full /now page{nowUpdated && ` · ${nowUpdated}`}
        <ArrowRight
          class="size-3.5 transition-transform group-hover:translate-x-0.5"
        />
      </a>
    </div>

    <!--
      Bento: on desktop each column stacks its cards at their own height, so
      the splits don't line up across columns. Below that the column wrappers
      are display: contents and the cards flow in the grid as usual.
    -->
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div class="contents lg:col-span-2 lg:flex lg:flex-col lg:gap-3">
        <!-- This year in media, live from what.pm -->
        <article data-reveal class="above-grain card p-6 sm:col-span-2 sm:p-7">
          <MediaChart client:visible initial={summary} />
        </article>

        <!-- Reading, live from what.pm -->
        <article data-reveal class="card p-6 sm:col-span-2 sm:p-7 lg:flex-1">
          <ReadingCard client:visible initial={summary} />
        </article>
      </div>

      <div class="contents lg:flex lg:flex-col lg:gap-3">
        <!-- Now playing, live from Last.fm -->
        <article data-reveal style="--delay: 60ms" class="card p-6 sm:p-7">
          <NowPlaying client:load initial={track} />
        </article>

        <!-- Scrobbles over time, live from Last.fm -->
        <article
          data-reveal
          style="--delay: 60ms"
          class="card p-6 sm:p-7 lg:flex-1"
        >
          <ScrobblesCard client:visible initial={stats} />
        </article>
      </div>

      <!-- Japanese, live from WaniKani -->
      <article
        data-reveal
        style="--delay: 120ms"
        class="card p-6 sm:col-span-2 sm:p-7 lg:col-span-1"
      >
        <KanjiCard client:visible initial={progress} />
      </article>
    </div>
  </section>
</BaseLayout>
